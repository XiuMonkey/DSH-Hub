---
# DSH Hub 的 C++ 排版规则。改代码前请先按本文件格式化，避免风格漂移。
# 三条硬规则：
#   1. 空行只在"逻辑块之间"，块内不撒空行（尤其 include 连成一片）
#   2. 注释要么在若干行代码上方成块，要么行尾简短一句；不搞一行代码一行注释
#   3. 函数调用的实参不跨行拆开
Language: Cpp
BasedOnStyle: LLVM

# ---- 缩进：沿用现有风格（Tab 缩进，视觉宽度 4）----
IndentWidth: 4
TabWidth: 4
UseTab: ForIndentation
ContinuationIndentWidth: 4
NamespaceIndentation: All
AccessModifierOffset: -4

# ---- 列宽：给足空间，避免为折行而拆参数 ----
ColumnLimit: 120

# ---- 规则 3：实参/形参尽量排在一行 ----
BinPackArguments: true
BinPackParameters: true
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
AllowAllConstructorInitializersOnNextLine: true
AlignAfterOpenBracket: Align
AlignOperands: false

# ---- 大括号：函数/类/命名空间换行（Allman），控制语句与花括号同行 ----
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: Never
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: false
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

# ---- 规则 1：空行最多留 1 行 ----
MaxEmptyLinesToKeep: 1

# ---- 不动 include 顺序（本项目按模块手工分组）与 using 顺序 ----
SortIncludes: false
SortUsingDeclarations: false

# ---- 规则 2：注释文字不自动重排（中英文混排重排会乱），交给人工/审阅 ----
ReflowComments: false

# ---- 少做无谓对齐，减少噪声 diff ----
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: false
AlignTrailingComments: false
AlignEscapedNewlines: Left

# ---- 短结构不合并成一行（Qt/lambda 代码里单行化反而难读）----
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false

# ---- 指针/引用贴类型：QWidget* parent / const QString& x ----
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

# ---- 其它 ----
IncludeBlocks: Preserve
EmptyLineBeforeAccessModifier: Leave
IndentCaseLabels: false
IndentPPDirectives: None
FixNamespaceComments: true
SpaceAfterTemplateKeyword: false
Cpp11BracedListStyle: false
BreakConstructorInitializers: BeforeComma
PackConstructorInitializers: Never
Standard: c++17
